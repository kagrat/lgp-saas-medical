# Copie ce fichier en ".env" dans frontend-web/
VITE_API_URL=http://localhost:8000

# --- Mode maintenance (suspension d'accès) ---
# En fonctionnement normal: false (ou ne rien définir).
# Pour SUSPENDRE l'accès: Vercel -> Settings -> Environment Variables ->
# VITE_MAINTENANCE_MODE = true, puis Deployments -> Redeploy.
# Pour RÉTABLIR: repasser à false et redéployer.
VITE_MAINTENANCE_MODE=false
# Message affiché (optionnel - un message par défaut est prévu):
# VITE_MAINTENANCE_MESSAGE=
