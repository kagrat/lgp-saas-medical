{
  "name": "lgp-console",
  "version": "1.0.0",
  "description": "LGP Console - Application Desktop pour les etablissements et le Super Admin",
  "main": "main.js",
  "author": "LGP HOLDINGS",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.lgpholdings.console",
    "productName": "LGP Console",
    "files": [
      "main.js",
      "preload.js"
    ],
    "win": {
      "target": "nsis"
     
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.medical"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
