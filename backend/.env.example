# Copie ce fichier en ".env" et remplis les vraies valeurs.
# NE JAMAIS committer le fichier ".env" reel dans un depot Git.

# Base de donnees PostgreSQL (Railway, VPS, ou local)
DATABASE_URL=postgresql://user:password@localhost:5432/lgp_medical

# Cle secrete JWT - genere une valeur aleatoire forte, jamais celle-ci en prod
# Exemple pour en generer une: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_generate_a_real_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email SMTP (confirmations RDV, rappels)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change_me
SMTP_PASSWORD=change_me
SMTP_FROM=noreply@lgp-medical.example.com

# SMS - a brancher sur un vrai fournisseur (Twilio, Vonage, ou un agregateur local Benin)
# Le code fournit uniquement l'interface SMSProvider (services a implementer),
# aucun fournisseur n'est cable en dur car aucune cle n'est disponible ici.
SMS_API_KEY=
SMS_API_URL=

# Environnement
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
